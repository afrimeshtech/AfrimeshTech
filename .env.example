# ---------------------------------------------------------------------------
# AfriMesh Commerce Platform (Project Nexus) - environment
# ---------------------------------------------------------------------------

# DATABASE
# Leave DATABASE_URL unset to run the embedded PostgreSQL (PGlite/WASM) that
# stores data in ./.pgdata - no server install required. This is dev-only.
#
# Set it to a real PostgreSQL server for staging/production. The schema and all
# SQL are plain PostgreSQL, so nothing else changes:
# DATABASE_URL=postgresql://afrimesh:afrimesh@localhost:5432/afrimesh

# AUTH - 32+ char secret used to sign session tokens (HS256)
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# PAYMENTS
# Provider abstraction. "mock" settles instantly and is the default for dev.
# Adapters for regional providers plug in behind the same interface.
PAYMENT_PROVIDER=mock
# PAYSTACK_SECRET_KEY=
# FLUTTERWAVE_SECRET_KEY=

# NOTIFICATIONS
# "console" writes to stdout + the in-app inbox. Swap for real SMS/push later.
NOTIFICATION_TRANSPORT=console
# TERMII_API_KEY=
# SMTP_URL=

# PLATFORM
PLATFORM_FEE_BPS=150
DEFAULT_CURRENCY=NGN
DEFAULT_COUNTRY=NG
RESERVATION_TTL_MINUTES=20

# LOGISTICS
# Share of an order's delivery fee that goes to the delivery partner, in basis
# points. The platform keeps the remainder.
RIDER_SHARE_BPS=8000

# REWARDS
# Cashback on the goods value of a completed order, in basis points. Funded
# from platform revenue and automatically capped at PLATFORM_FEE_BPS, so a
# reward can never exceed the commission that pays for it.
CASHBACK_BPS=50
