{
  "name": "afrimesh-platform",
  "version": "1.0.0",
  "private": true,
  "description": "AfriMesh Commerce Platform (Project Nexus) - Proximity Commerce & Payment Infrastructure",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:push": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/db-push.ts",
    "db:seed": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/seed.ts",
    "db:reset": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/db-reset.ts",
    "test": "node --experimental-strip-types --import ./scripts/register-alias.mjs --test \"src/**/*.test.ts\"",
    "verify": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/verify.ts",
    "dev:session": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/dev-session.ts",
    "setup": "npm run db:reset"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "next": "^16.2.12",
    "pg": "^8.13.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  }
}
